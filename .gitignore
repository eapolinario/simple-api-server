# Binaries (root-anchored so they don't shadow cmd/simple-apiserver/)
/simple-api-server
/simple-apiserver
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.txt
coverage.html

# Go workspace
go.work.sum

# Nix / direnv
.direnv
result
result-*

# Codegen tool binaries (installed by hack/update-codegen.sh)
/.tools/

# Editor agent integrations (e.g., emacs agent-shell)
/.agent-shell/

# Local dev runtime artifacts produced by `just dev` / `just dev-kubeconfig`
/.local-run/
